<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the token is tied to this phone's keystore anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
